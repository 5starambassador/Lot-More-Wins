# ==============================================================================
# LOT MORE WINS — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real credentials!

# Node Environment
NODE_ENV=development

# Database (PostgreSQL + Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lot_more_wins?schema=public"

# Next.js API & Public URL
PORT=3000
NEXT_PUBLIC_API_URL="https://lotmore-wins.vercel.app/api"

# JWT Authentication
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379"

# ==============================================================================
# PHASE 2: CENTRALIZED MESSAGING CONFIGURATION
# ==============================================================================
# Initial default only. Once the Super Admin saves Settings, the database value is the
# runtime source of truth and this variable is ignored. Strictly 'email' or 'whatsapp'.
MESSAGING_MODE=email

# Returns the OTP in API responses for automated testing. Never enable in production.
ENABLE_DEV_OTP=false

# Email Provider Configuration (used when messaging mode is email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Lot More Wins <notifications@lotmorewins.com>"

# MSG91 WhatsApp Configuration (used when messaging mode is whatsapp)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_INTEGRATED_NUMBER=your_msg91_integrated_number
MSG91_OTP_TEMPLATE_NAME=lotmorewins_otp
# Bill message template. Register it in MSG91 with 9 body variables, in this order:
# {{1}} name, {{2}} outlet, {{3}} bill number, {{4}} bill amount, {{5}} discount,
# {{6}} amount paid, {{7}} purchase points, {{8}} points note, {{9}} app download link.
# The download link, messaging mode and all discount/points values come from the
# Super Admin Settings page, not from environment variables.
MSG91_INVOICE_TEMPLATE_NAME=lotmorewins_invoice

# ==============================================================================
# PHASE 3: SUPER ADMIN BOOTSTRAP (read by prisma/seed.ts only)
# ==============================================================================
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Cloudinary image storage (outlet logos & galleries, partner profile photos).
# Every upload from the Super Admin panel, the Outlet Admin app and the Partner app goes
# through POST /api/media, which stores the image in Cloudinary. These are demo placeholders:
# while they are in place uploads are kept in the database instead, so replace all three
# with the values from your Cloudinary dashboard to switch Cloudinary on.
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo_api_key
CLOUDINARY_API_SECRET=demo_api_secret
CLOUDINARY_FOLDER=lot-more-wins

# AWS S3 / Cloudflare R2 Object Storage
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"
S3_BUCKET="lot-more-wins-uploads"
S3_REGION="ap-south-1"
S3_ENDPOINT=""

# Expo Mobile Apps Public Config (used by partner-app and outlet-admin-app)
EXPO_PUBLIC_API_URL="https://lotmore-wins.vercel.app/api"
