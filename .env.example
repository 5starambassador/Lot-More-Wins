# ==============================================================================
# LOT MORE WINS — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real credentials!

# Node Environment
NODE_ENV=development

# Database (PostgreSQL + Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lot_more_wins?schema=public"

# Next.js API & Public URL
PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# JWT Authentication
JWT_SECRET="development-jwt-secret-minimum-32-characters-change-in-production"
JWT_REFRESH_SECRET="development-jwt-refresh-secret-minimum-32-characters-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379"

# WhatsApp Business API
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"

# OTP Provider
OTP_PROVIDER_KEY="your_otp_provider_api_key_here"
OTP_PROVIDER_SENDER_ID="LTMORE"

# AWS S3 / Cloudflare R2 Object Storage
S3_ACCESS_KEY="your_s3_access_key"
S3_SECRET_KEY="your_s3_secret_key"
S3_BUCKET="lot-more-wins-uploads"
S3_REGION="ap-south-1"
S3_ENDPOINT=""

# Expo Mobile Apps Public Config (used by partner-app and outlet-admin-app)
EXPO_PUBLIC_API_URL="http://localhost:3000/api"
