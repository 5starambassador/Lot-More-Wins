{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && npx -y pnpm@12.6.0 install --frozen-lockfile",
  "buildCommand": "cd ../.. && npx prisma generate --schema=prisma/schema.prisma && cd apps/web && npx next build",
  "crons": [
    { "path": "/api/cron/diwali-greeting", "schedule": "30 3 8 11 *" },
    { "path": "/api/cron/dinner-greeting", "schedule": "15 12 6 11 *" }
  ]
}
