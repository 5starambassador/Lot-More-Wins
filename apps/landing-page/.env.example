# Lot More Wins API. The download buttons read the Super Admin's choice per platform
# (Settings → App downloads) from <API>/app-links: a store link opens Google Play / the App Store,
# the web version (or no answer) opens the install guide below.
VITE_API_URL="https://superadmin.lotmorewins.com/api"

# Partner App web version (the Expo web export). The "How to install" guides send people here to
# add it to their home screen.
VITE_PARTNER_WEB_URL="https://partner.lotmorewins.com"

# Public address of this site, used inside the download QR code. Leave unset to use the
# address the page is being viewed on.
VITE_SITE_URL=""

# Outlet Admin app Google Play listing, for the /outlet-admin page. Leave unset for the default
# https://play.google.com/store/apps/details?id=com.lotmorewins.outletadmin
VITE_OUTLET_PLAY_URL=""
