# Partner App web version (the Expo web export). "Download for iOS" sends people here to add
# it to their home screen.
VITE_PARTNER_WEB_URL="https://partner.lotmorewins.com"

# Public address of this site, used inside the download QR code. Leave unset to use the
# address the page is being viewed on.
VITE_SITE_URL=""

# Lot More Wins API. The download buttons read the Android / iOS links set in the Super Admin
# panel (Settings → App downloads) from <API>/app-links. Android uses that link only; iOS falls
# back to VITE_PARTNER_WEB_URL.
VITE_API_URL="https://superadmin.lotmorewins.com/api"
