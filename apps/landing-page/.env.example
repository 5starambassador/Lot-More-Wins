# Partner App web version (the Expo web export). "Download for iOS" sends people here to add
# it to their home screen.
VITE_PARTNER_WEB_URL="https://your-partner-app.vercel.app"

# Android APK location. Leave unset to serve public/lot-more-wins-partner.apk from this site,
# or point it at an externally hosted APK (the file is over GitHub's 100 MB limit).
VITE_ANDROID_APK_URL=""

# Public address of this site, used inside the download QR code. Leave unset to use the
# address the page is being viewed on.
VITE_SITE_URL=""
