{
  "expo": {
    "name": "Lot More Wins Partner",
    "slug": "partner-lot-more-wins-app",
    "owner": "webdeveloperachariyas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lotmorewins-partner",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D12426"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lotmorewins.partner",
      "bundleNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D12426"
      },
      "package": "com.lotmorewins.partner",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Lot More Wins Partner to scan QR codes."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Lot More Wins Partner to use your location to fill in your city, state and pincode."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D12426"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Lot More Wins Partner to save your QR codes to your photos.",
          "savePhotosPermission": "Allow Lot More Wins Partner to save your QR codes to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lot More Wins Partner to choose your profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "333b102d-647f-4b0b-a969-f09d3d3ffea7"
      }
    },
    "backgroundColor": "#D12426"
  }
}